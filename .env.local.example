NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Indxd3BwbWJydHR2ZHJzeHBsbnNmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzYwNzkxNDUsImV4cCI6MjA5MTY1NTE0NX0.3wl_1tvF8cotPdVg5Q0uI5x2VMJEmROZEwJTGMs5xGg

# Service-role key (server-side only — never expose).
# REQUIRED for:
#   - The Smartlead sync script (writes despite RLS).
#   - The /api/auth/forgot route — looks up users via the GoTrue admin API
#     so we can refuse reset links for unregistered emails.
# Grab from Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site origin used for password-reset redirect links (e.g.
# https://outbound-reporting-dashboard.vercel.app). If unset, falls back to
# the incoming request origin — set this in production to avoid preview
# deployments sending links that bounce against a stale Supabase Site URL.
NEXT_PUBLIC_SITE_URL=

# Smartlead — open.cx account ONLY. NEVER paste an OutSearched key here.
SMARTLEAD_API_KEY_OPENCX=

# OpenAI — used by the Smartlead ICP/TAM coverage sync to classify leads
# against the v3 taxonomy. Falls back to OPENAI_API_KEY.
OPENAI_API_KEY_OPENCX=

# Shared secret for the Vercel Cron sync route (/api/cron/sync-smartlead).
# Vercel auto-injects this as `Authorization: Bearer <CRON_SECRET>` when the
# env var is set in the project. Generate with `openssl rand -hex 32`.
CRON_SECRET=
